\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Schwarzschild in the coordinates of \eqref  {eq:schwarzschild-kerr-schild}, with lengths and times in units of $Gm$. Left: constant-$\lambda $ circles in the $r_3=0$ plane; the solid black circle is the horizon, with its interior shaded pale gray. Right: future radial light cones, drawn as local tangent directions, with time increasing upward. The dashed black curve follows the chosen frame observer, $\,\mathrm  dr/\,\mathrm  dt=-Gm/(r+Gm)$, starting at $r=3Gm$ when $t=0$; it is not a free-fall trajectory. The spatial panel shows coordinate contours, not proper distances or an isometric embedding.}}{117}{figure.11}\protected@file@percent }
\newlabel{fig:metric-schwarzschild}{{11}{117}{Schwarzschild in the coordinates of \eqref {eq:schwarzschild-kerr-schild}, with lengths and times in units of $Gm$. Left: constant-$\lambda $ circles in the $r_3=0$ plane; the solid black circle is the horizon, with its interior shaded pale gray. Right: future radial light cones, drawn as local tangent directions, with time increasing upward. The dashed black curve follows the chosen frame observer, $\dd r/\dd t=-Gm/(r+Gm)$, starting at $r=3Gm$ when $t=0$; it is not a free-fall trajectory. The spatial panel shows coordinate contours, not proper distances or an isometric embedding}{figure.11}{}}
