\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The same events in two inertial frames, with $x={\bm  {\mathrm  {u}}}\cdot {\bm  {\mathrm  {r}}}$, $x'={\bm  {\mathrm  {u}}}\cdot {\bm  {\mathrm  {r}}}'$, and $\beta =3/5$. From the common event $O$, $A$ lies on the unprimed rest clock (solid), $B$ on the primed rest clock (dashed), $C$ on the future light cone (dotted), and $D$ at simultaneous unprimed separation. Both clocks accumulate $\Delta s=1$, although their coordinate increments differ. The space-like pair $OD$ is simultaneous only in the left panel. Equal spatial and temporal scales keep null lines at $45^\circ $.}}{30}{figure.1}\protected@file@percent }
\newlabel{fig:observer-events}{{1}{30}{The same events in two inertial frames, with $x=\bu \dotprod \br $, $x'=\bu \dotprod \br '$, and $\beta =3/5$. From the common event $O$, $A$ lies on the unprimed rest clock (solid), $B$ on the primed rest clock (dashed), $C$ on the future light cone (dotted), and $D$ at simultaneous unprimed separation. Both clocks accumulate $\Delta s=1$, although their coordinate increments differ. The space-like pair $OD$ is simultaneous only in the left panel. Equal spatial and temporal scales keep null lines at $45^\circ $}{figure.1}{}}
