\newlabel{eq:length-contraction}{{7.10}{32}{Length contraction and simultaneity}{equation.7.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Length contraction selects simultaneous endpoint events. The solid lines are the two ends of a rod at unprimed rest, with $x={\bm  {\mathrm  {u}}}\cdot {\bm  {\mathrm  {r}}}$ and rest length $\ell $; $\beta =3/5$. The dotted segment $OA$ measures its length at $t=0$. The dash-dotted segment $OB$ instead has $t'=0$ and measures $\Delta x'=4\ell /5$ in the moving frame. The event $A$ has $t'=-3\ell /4$, so $OA$ cannot be used as that frame's simultaneous length measurement. Labels identify the same three events in both panels.}}{33}{figure.3}\protected@file@percent }
\newlabel{fig:observer-rod}{{3}{33}{Length contraction selects simultaneous endpoint events. The solid lines are the two ends of a rod at unprimed rest, with $x=\bu \dotprod \br $ and rest length $\ell $; $\beta =3/5$. The dotted segment $OA$ measures its length at $t=0$. The dash-dotted segment $OB$ instead has $t'=0$ and measures $\Delta x'=4\ell /5$ in the moving frame. The event $A$ has $t'=-3\ell /4$, so $OA$ cannot be used as that frame's simultaneous length measurement. Labels identify the same three events in both panels}{figure.3}{}}
