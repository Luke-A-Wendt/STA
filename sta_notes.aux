\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Kerr coordinate slices with spin along $+r_3$ and $Gm\lVert {\bm  {\mathrm  {\omega }}}\rVert =1/4$, so $\ell ^2\lVert {\bm  {\mathrm  {\omega }}}\rVert =0.8Gm$ and the horizon is $\epsilon =1.6Gm$. Left: the $r_2=0$ slice, with dashed black contours of the ellipsoidal radius $\epsilon $. Right: the $r_3=0$ slice, with a dashed constant-$\lambda $ contour and equal-length arrows showing the direction of $\,\mathrm  d{\bm  {\mathrm  {r}}}/\,\mathrm  dt=-\lambda {\bm  {\mathrm  {u}}}/(1+\lambda )$. Solid black curves mark the horizon and outer stationary limit, with the exterior ergoregion shaded gray. Pale gray marks the horizon's interior. The arrows describe the chosen frame observers, not general free fall; the coordinate shapes are not an isometric embedding.}}{119}{figure.12}\protected@file@percent }
\newlabel{fig:metric-kerr}{{12}{119}{Kerr coordinate slices with spin along $+r_3$ and $Gm\lVert \vstyle {\omega }\rVert =1/4$, so $\ell ^2\lVert \vstyle {\omega }\rVert =0.8Gm$ and the horizon is $\epsilon =1.6Gm$. Left: the $r_2=0$ slice, with dashed black contours of the ellipsoidal radius $\epsilon $. Right: the $r_3=0$ slice, with a dashed constant-$\lambda $ contour and equal-length arrows showing the direction of $\dd \br /\dd t=-\lambda \bu /(1+\lambda )$. Solid black curves mark the horizon and outer stationary limit, with the exterior ergoregion shaded gray. Pale gray marks the horizon's interior. The arrows describe the chosen frame observers, not general free fall; the coordinate shapes are not an isometric embedding}{figure.12}{}}
